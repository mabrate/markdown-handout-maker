{
  "name": "classroom-handout-maker",
  "version": "0.1.0",
  "description": "Local Markdown handout editor and print preview",
  "author": "Handout Maker",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/test-model-download.js",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.classroom.handoutmaker",
    "productName": "Handout Maker",
    "files": [
      "renderer/**/*",
      "!renderer/**/*.gguf",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "node-llama-cpp": "^3.20.0"
  }
}
